#!/bin/sh
# Copyright (c) 2026 CRELLIA S.L. — part of SRS-DD, distributed under the MIT License
# SRS-DD pre-commit gate. One-time setup after cloning:
#     git config core.hooksPath .githooks
# Runs the gate a target's hook runs (ci/pre-commit), then the local gate:
# YAML validation of the pipeline and the shipped templates, then every
# suite in tests/ — the same scripts CI runs. See tools/ci_selftest.sh for
# details.
# implements: FR-GND-310, FR-GND-570, FR-ARCH-300, FR-CI-180, INV-SKILL-010
set -e
cd "$(git rev-parse --show-toplevel)"

# This repository is the first project the gate applies to, and keeps a
# register and a layer of its own: the checkers, every generated file
# compared with what is staged, and what the requirements this commit
# touches are standing on — a report that fails nothing.
python3 srs-dd/tools/srs_gate.py --staged
# srs-end: FR-GND-310, FR-GND-570, FR-ARCH-300, FR-CI-180, INV-SKILL-010

exec tools/ci_selftest.sh
